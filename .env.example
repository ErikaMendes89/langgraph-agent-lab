# Configuração opcional. Sem credenciais. O aplicativo não carrega .env automaticamente.
INCIDENT_LAB_REQUEST="Investigue por que o pedido 123 apresentou inconsistência e gere um relatório."
# demo preserva o exemplo sem LLM; ollama ativa a consulta aos logs fictícios.
INCIDENT_LAB_MODE=demo
INCIDENT_LAB_MODEL=qwen3:1.7b

# No modo ollama, exige consulta ao ID configurado (1 a 12 dígitos).
# Descomente para investigar; omita para perguntas de escopo/esclarecimento.
# INCIDENT_LAB_ORDER_ID=123

# No modo ollama, pausa para revisão humana do relatório simulado na CLI.
# Aceita somente true ou false. A aprovação não grava nem publica arquivos.
INCIDENT_LAB_REQUIRE_APPROVAL=false
